# 도로망 그래프 JSON (비우면 광주 일대 가상 샘플 그래프)
# data/gangnam.json 은 강남역·역삼역 일대 실제 도로망(OSM)이다
GRAPH_PATH=data/gangnam.json
MAX_SNAP_DISTANCE_M=1000

# 비우면 인메모리 캐시 / 그래프 기반 핫스팟으로 대체
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://easyroute:easyroute@localhost:5432/easyroute

# 카카오 로컬 API REST 키
KAKAO_REST_API_KEY=

CORS_ORIGINS=["*"]
